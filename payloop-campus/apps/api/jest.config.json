{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/src"],
  "testMatch": ["**/__tests__/**/*.test.ts"],
  "moduleNameMapper": {
    "^@payloop/(.*)$": "<rootDir>/../../packages/$1/src"
  },
  "coverageDirectory": "coverage",
  "collectCoverageFrom": ["src/**/*.ts", "!src/**/*.d.ts"]
}
